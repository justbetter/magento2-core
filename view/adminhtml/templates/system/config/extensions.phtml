<?php

declare(strict_types=1);

/**
 * @var \JustBetter\Core\Block\Adminhtml\System\Config\Extensions $block
 * @var \Magento\Framework\Escaper $escaper
 */

$extensions = $block->getExtensions();
?>


<div class="justbetter-extensions-list">
    <?php if (empty($extensions)): ?>
        <div class="message message-notice">
            <span><?= $escaper->escapeHtml(__('No JustBetter extensions installed.')) ?></span>
        </div>
    <?php else: ?>
        <table class="admin__table-primary">
            <thead>
                <tr>
                    <th class="col-name"><?= $escaper->escapeHtml(__('Module')) ?></th>
                    <th class="col-version"><?= $escaper->escapeHtml(__('Version')) ?></th>
                    <th class="col-status"><?= $escaper->escapeHtml(__('Status')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($extensions as $extension): ?>
                    <tr>
                        <td class="col-name">
                            <?php if ($extension['url']): ?>
                                <a href="<?= $escaper->escapeUrl($extension['url']) ?>"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="<?= $escaper->escapeHtmlAttr(__('View on GitHub')) ?>">
                                    <strong><?= $escaper->escapeHtml($extension['name']) ?></strong>
                                </a>
                            <?php else: ?>
                                <strong><?= $escaper->escapeHtml($extension['name']) ?></strong>
                            <?php endif; ?>
                        </td>
                        <td class="col-version">
                            <span class="version-badge"><?= $escaper->escapeHtml($extension['version']) ?></span>
                        </td>
                        <td class="col-status">
                            <?php if ($extension['enabled']): ?>
                                <span class="grid-severity-notice"><span><?= $escaper->escapeHtml(__('Enabled')) ?></span></span>
                            <?php else: ?>
                                <span class="grid-severity-critical"><span><?= $escaper->escapeHtml(__('Disabled')) ?></span></span>
                            <?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>

